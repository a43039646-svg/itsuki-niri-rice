{
  "$schema": "https://raw.githubusercontent.com/ErikReider/SwayNotificationCenter/main/src/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "control-center-width": 390,
  "control-center-height": -1,
  "notification-window-width": 340,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "keyboard-shortcuts": true,
  "widgets": [
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "Wi-Fi",
          "type": "normal",
          "command": "sh -c 'python3 \"$HOME/.local/bin/itsuki-wifi-menu.py\"'"
        }
      ]
    },
    "backlight": {
      "label": "Brightness",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 0
    },
    "volume": {
      "label": "Volume",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-per-app": false
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available"
    },
    "title": {
      "text": "Itsuki quick settings",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "notifications": {
      "vexpand": false
    }
  }
}
