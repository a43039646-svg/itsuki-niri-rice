{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 10,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "custom/notification",
    "tray"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "sort-by-id": true,
    "format-icons": {
      "focused": "●",
      "active": "●",
      "default": "○",
      "empty": "○",
      "urgent": "!"
    }
  },
  "clock": {
    "format": " {:%H:%M  ·  %a %d %b}",
    "tooltip-format": "{:%A, %d %B %Y}\\n{:%H:%M:%S}"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "tooltip": true,
    "scroll-step": 5
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " LAN",
    "format-disconnected": " offline",
    "tooltip-format": "{essid}: {ipaddr}/{cidr}"
  },
  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "AC",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive-items": true,
    "tooltip": true
  },
  "margin": "8px 18px 0px 18px",
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
